* text=auto eol=lf
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf
*.sh text eol=lf
*.conf text eol=lf

*.ply binary
*.splat binary

mat-synth/* linguist-vendored
tex/* linguist-vendored
www/** linguist-vendored

*.lock -diff

# Preserve generated evidence and upstream source bytes (including recorded hashes).
docs/procedural_indoor/*.svg -whitespace linguist-generated
docs/procedural_indoor/*.log -whitespace linguist-generated
docs/evidence/** linguist-generated
docs/evidence/**/*.svg -text -whitespace
docs/evidence/**/*.log -text -whitespace
docs/evidence/**/*.txt -text -whitespace
docs/evidence/**/*.csv -text -whitespace
third_party/** linguist-vendored
third_party/wgpu-core/src/timestamp_normalization/common.wgsl whitespace=-blank-at-eol
third_party/wgpu-hal/README.md whitespace=-blank-at-eof
